{
  "name": "vega-providers-api",
  "version": "1.0.0",
  "description": "Vega Providers API — Unified API for 60+ content providers",
  "main": "website/server.js",
  "scripts": {
    "start": "node website/server.js",
    "dev": "node website/server.js",
    "build": "node build-bundled.js && node build-client.js",
    "build:client": "node build-client.js",
    "build:start": "npm run build && npm start",
    "test": "node tests/test-providers.js",
    "test:provider": "node tests/test-provider.js",
    "build:dev": "cross-env SKIP_MINIFY=true node build-bundled.js",
    "watch": "nodemon --config nodemon.json",
    "watch:dev": "nodemon --watch providers --ext ts --exec \"npm run build\" & npm run dev",
    "dev:auto": "concurrently \"nodemon --watch providers --ext ts --exec \\\"npm run build:dev\\\"\" \"npm run dev\"",
    "auto": "node auto-dev.js"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/node": "^24.0.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "esbuild": "^0.27.2",
    "nodemon": "^3.1.10",
    "playwright-core": "^1.64.0",
    "terser": "^5.43.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axios": "^1.10.0",
    "cheerio": "^1.1.0",
    "cors": "^2.8.5",
    "curl-cffi-node": "^0.1.8",
    "express": "^4.21.2",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.0.1",
    "tls-impersonate": "^0.1.0",
    "zod": "^4.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
